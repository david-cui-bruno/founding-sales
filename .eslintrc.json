{
  "root": true,
  "env": {
    "browser": true,
    "es6": true,
    "node": true
  },
  "extends": [
    "eslint:recommended",
    "plugin:@typescript-eslint/eslint-recommended",
    "plugin:@typescript-eslint/recommended",
    "plugin:import/recommended",
    "plugin:import/electron",
    "plugin:import/typescript"
  ],
  "parser": "@typescript-eslint/parser",
  "ignorePatterns": [
    "cloud/lambdas/**"
  ],
  "overrides": [
    {
      "files": [
        "src/main/research/companyPageText.ts"
      ],
      "settings": {
        "import/core-modules": ["cheerio/slim"]
      }
    },
    {
      "files": [
        "scripts/releaseArtifactCore.cjs"
      ],
      "rules": {
        "@typescript-eslint/no-require-imports": [
          "error",
          {
            "allow": [
              "^node:crypto$",
              "^node:fs$",
              "^node:path$",
              "^@electron/asar$",
              "^\\./releaseMarkerContract\\.cjs$"
            ]
          }
        ]
      }
    },
    {
      "files": [
        "cloud/lambdas/**/*.{js,mjs,cjs,ts,mts,cts,tsx}"
      ],
      "settings": {
        "import/resolver": "../../../scripts/lambdaImportResolver.cjs"
      }
    },
    {
      "files": [
        "scripts/probeEncryptedSqlite.cjs"
      ],
      "rules": {
        "@typescript-eslint/no-require-imports": [
          "error",
          {
            "allow": [
              "^node:fs$",
              "^node:path$",
              "^electron$",
              "^better-sqlite3-multiple-ciphers$",
              "^better-sqlite3-multiple-ciphers/package\\.json$",
              "^kysely$"
            ]
          }
        ]
      }
    },
    {
      "files": [
        "scripts/probeEncryptedSqliteNative.cjs"
      ],
      "rules": {
        "@typescript-eslint/no-require-imports": [
          "error",
          {
            "allow": [
              "^better-sqlite3-multiple-ciphers$",
              "^node:fs$",
              "^node:os$",
              "^node:path$"
            ]
          }
        ]
      }
    },
    {
      "files": [
        "scripts/lambdaImportResolver.cjs"
      ],
      "rules": {
        "@typescript-eslint/no-require-imports": [
          "error",
          {
            "allow": [
              "^node:module$",
              "^node:path$",
              "^typescript$"
            ]
          }
        ]
      }
    }
  ]
}
