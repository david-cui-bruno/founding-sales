{
  "name": "@fss/desktop",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "The thin Electron client: sign-in, device, session, version gate and the expiring offline cache.",
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:e2e": "playwright test --config playwright.config.ts",
    "test:host": "vitest run test/host",
    "prototype": "node --experimental-strip-types --disable-warning=ExperimentalWarning scripts/prototype.ts",
    "prototype:screens": "node --experimental-strip-types --disable-warning=ExperimentalWarning scripts/prototypeScreens.ts",
    "package": "node --experimental-strip-types --disable-warning=ExperimentalWarning scripts/package.ts",
    "verify:package": "node --experimental-strip-types --disable-warning=ExperimentalWarning scripts/verifyPackage.ts"
  },
  "dependencies": {
    "@fss/contracts": "*",
    "@radix-ui/react-label": "2.1.16",
    "@radix-ui/react-slot": "1.4.0",
    "@tanstack/react-query": "5.104.1",
    "@twilio/voice-sdk": "2.18.5",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.52.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "7.89.0",
    "sharp": "0.35.5",
    "tailwind-merge": "3.7.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@electron/asar": "4.3.1",
    "@electron/fuses": "2.1.3",
    "@electron/notarize": "^3.1.1",
    "@electron/osx-sign": "^2.7.0",
    "@electron/packager": "^20.3.0",
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "electron": "44.5.1",
    "esbuild": "0.28.2",
    "eslint-plugin-react-hooks": "7.1.1",
    "jsdom": "30.1.2",
    "playwright": "^1.63.0",
    "postcss": "8.5.29",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "1.4.0",
    "typescript": "^5.9.3",
    "vitest": "^5.0.3"
  }
}
