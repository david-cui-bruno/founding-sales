{
  "name": "callie-client",
  "productName": "Callie",
  "version": "0.1.0",
  "description": "Thin macOS client for the Callie worker: views, commands, one device token.",
  "main": ".vite/build/main.js",
  "private": true,
  "engines": {
    "node": ">=24.0.0 <25.0.0"
  },
  "scripts": {
    "start": "electron-forge start",
    "package": "node scripts/writeClientReleaseMarker.mjs && electron-forge package",
    "make": "electron-forge make",
    "build": "node scripts/buildClient.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:browser": "playwright test --workers=1",
    "verify:package": "node scripts/verifyClientPackage.mjs",
    "postinstall": "install-electron"
  },
  "author": {
    "name": "David Cui",
    "email": "david_cui@brown.edu"
  },
  "license": "MIT",
  "devDependencies": {
    "@electron-forge/cli": "^7.11.2",
    "@electron-forge/maker-zip": "^7.11.2",
    "@electron-forge/plugin-vite": "^7.11.2",
    "@electron-forge/shared-types": "7.11.2",
    "@electron/asar": "3.4.1",
    "@electron/fuses": "2.1.3",
    "@eslint/js": "^9.39.5",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@typescript-eslint/eslint-plugin": "8.68.0",
    "@typescript-eslint/parser": "8.68.0",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "44.0.0",
    "eslint": "^9.39.5",
    "eslint-plugin-import": "^2.32.0",
    "globals": "^17.12.0",
    "playwright": "^1.62.1",
    "typescript": "^5.9.3",
    "vite": "^5.4.21",
    "vitest": "^2.1.9"
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zod": "^4.5.4"
  }
}
