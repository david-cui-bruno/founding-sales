# EXAMPLE ONLY. No backend existence, access or approval is implied.
# Complete the README backend/ownership review before creating backend.hcl.
# Use reviewed public identifiers, never credentials. Never use the legacy key
# cloud/terraform.tfstate or migrate the whole sourcing state into this root.
bucket         = "REVIEWED_WORKER_STATE_BUCKET"
key            = "cloud/delegated-worker/terraform.tfstate"
region         = "us-east-1"
dynamodb_table = "REVIEWED_WORKER_LOCK_TABLE"
encrypt        = true
kms_key_id     = "arn:aws:kms:us-east-1:REVIEWED_ACCOUNT_ID:key/REVIEWED_STATE_KMS_KEY_ID"
