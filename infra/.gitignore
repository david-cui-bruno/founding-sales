# Provider downloads and working directories are disposable. CI re-initializes
# every module and root with `terraform init -backend=false`.
.terraform/
.terraform.tfstate.lock.info
crash.log
crash.*.log

# The four roots' provider lock files are committed, for darwin_arm64 and linux_amd64
# (`terraform providers lock`, 26 September 2026): a laptop and CI resolve the same
# providers. A module's lock file is only what the offline gate's `init -backend=false`
# leaves behind, and is not kept.
modules/**/.terraform.lock.hcl

# State never belongs in the repository. It lives in the S3 backend.
*.tfstate
*.tfstate.*

# Variable files may carry environment detail. Roots take their values from the
# apply runbook and the deployment role, never from a committed tfvars file.
*.tfvars
*.tfvars.json
