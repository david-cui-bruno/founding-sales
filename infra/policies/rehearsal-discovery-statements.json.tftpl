{
  "Comment": [
    "FSS rehearsal discovery statements. Appended to the rehearsal role's policy only, and only when",
    "infra/scripts/render-deployment-role-policy.sh fss-rh is given --discovery. Never rendered for production.",
    "",
    "David's decision of 22 September 2026 (docs/decisions/g25-discovery-mode-for-the-rehearsal-role.md): six",
    "credentialed runs each found exactly one missing permission, forty minutes apart, because the services",
    "the apply asks for call each other in the caller's session and the message names the wrong resource.",
    "For one pass of create, deploy and full the rehearsal role holds a wide allow on the services the tree",
    "uses; the CloudTrail record of that pass (infra/scripts/deployment-role-actions-used.sh) is then the source of",
    "the exact policy, which is proved by one more run before anything touches production.",
    "",
    "Every deny of the normal document stays. These add the guards the wide allow needs: nothing named or",
    "tagged for production, nothing of the old stack, no change to the Terraform state infrastructure. IAM,",
    "STS and DynamoDB are not widened at all: the role keeps the scoped grants it has for those.",
    "",
    "IAM's ARN grammar: the partition and the service segment must be literal; region, account and the",
    "resource may carry wildcards. put-role-policy refused the first version of these guards for",
    "arn:aws:*:*:*:*fss-prod* (Resource vendor must be fully qualified), so every guard names its service",
    "and the renderer refuses any resource that does not."
  ],
  "Statement": [
    {
      "Sid": "DiscoveryAllowOnTheServicesTheTreeUsesRemoveAfterTheFirstFullRun",
      "Effect": "Allow",
      "Action": [
        "acm:*",
        "cloudfront:*",
        "cloudwatch:*",
        "ec2:*",
        "ecr:*",
        "ecs:*",
        "elasticloadbalancing:*",
        "kms:*",
        "logs:*",
        "rds:*",
        "s3:*",
        "secretsmanager:*",
        "sns:*",
        "tag:GetResources",
        "wafv2:*"
      ],
      "Resource": "*"
    },
    {
      "Sid": "DiscoveryGuardNothingNamedForProduction",
      "Effect": "Deny",
      "Action": "*",
      "Resource": [
        "arn:aws:cloudwatch:*:*:alarm:fss-prod*",
        "arn:aws:ecr:*:*:repository/fss-prod*",
        "arn:aws:ecs:*:*:cluster/fss-prod*",
        "arn:aws:ecs:*:*:service/fss-prod*",
        "arn:aws:ecs:*:*:task/fss-prod*",
        "arn:aws:ecs:*:*:task-definition/fss-prod*",
        "arn:aws:elasticloadbalancing:*:*:loadbalancer/app/fss-prod*",
        "arn:aws:elasticloadbalancing:*:*:targetgroup/fss-prod*",
        "arn:aws:elasticloadbalancing:*:*:listener/app/fss-prod*",
        "arn:aws:elasticloadbalancing:*:*:listener-rule/app/fss-prod*",
        "arn:aws:iam::*:role/fss-prod*",
        "arn:aws:kms:*:*:alias/fss-prod*",
        "arn:aws:logs:*:*:log-group:/fss/fss-prod*",
        "arn:aws:rds:*:*:db:fss-prod*",
        "arn:aws:rds:*:*:pg:fss-prod*",
        "arn:aws:rds:*:*:subgrp:fss-prod*",
        "arn:aws:rds:*:*:snapshot:fss-prod*",
        "arn:aws:s3:::fss-prod*",
        "arn:aws:secretsmanager:*:*:secret:fss-prod*",
        "arn:aws:sns:*:*:fss-prod*",
        "arn:aws:wafv2:*:*:regional/webacl/fss-prod*"
      ]
    },
    {
      "Sid": "DiscoveryGuardNothingTaggedForProduction",
      "Effect": "Deny",
      "Action": "*",
      "Resource": "*",
      "Condition": {
        "StringLike": {
          "aws:ResourceTag/NamePrefix": "fss-prod*"
        }
      }
    },
    {
      "Sid": "DiscoveryGuardNoTaggingForProduction",
      "Effect": "Deny",
      "Action": "*",
      "Resource": "*",
      "Condition": {
        "StringLike": {
          "aws:RequestTag/NamePrefix": "fss-prod*"
        }
      }
    },
    {
      "Sid": "DiscoveryGuardTheOldStackAndItsWorker",
      "Effect": "Deny",
      "Action": "*",
      "Resource": [
        "arn:aws:logs:*:*:log-group:*delegated-worker*",
        "arn:aws:s3:::*delegated-worker*",
        "arn:aws:secretsmanager:*:*:secret:*delegated-worker*",
        "arn:aws:sns:*:*:*delegated-worker*",
        "arn:aws:kms:*:*:alias/*delegated-worker*",
        "arn:aws:ecr:*:*:repository/*delegated-worker*",
        "arn:aws:ecs:*:*:*delegated-worker*",
        "arn:aws:rds:*:*:*delegated-worker*",
        "arn:aws:secretsmanager:*:*:secret:callie-sourcing*",
        "arn:aws:sns:*:*:callie-sourcing*",
        "arn:aws:logs:*:*:log-group:*callie-sourcing*",
        "arn:aws:kms:*:*:alias/callie-sourcing*",
        "arn:aws:ecs:*:*:*/callie-sourcing*",
        "arn:aws:rds:*:*:*:callie-sourcing*",
        "arn:aws:ecr:*:*:repository/callie-sourcing*"
      ]
    },
    {
      "Sid": "DiscoveryGuardTheStateBucketsConfiguration",
      "Effect": "Deny",
      "Action": [
        "s3:DeleteBucket",
        "s3:DeleteBucketPolicy",
        "s3:PutBucketPolicy",
        "s3:PutBucketVersioning",
        "s3:PutLifecycleConfiguration",
        "s3:PutEncryptionConfiguration",
        "s3:PutBucketObjectLockConfiguration",
        "s3:PutBucketPublicAccessBlock",
        "s3:PutBucketOwnershipControls",
        "s3:PutBucketAcl",
        "s3:PutReplicationConfiguration",
        "s3:PutBucketTagging",
        "s3:PutBucketLogging"
      ],
      "Resource": [
        "arn:aws:s3:::${state_bucket}",
        "arn:aws:s3:::callie-sourcing*"
      ]
    },
    {
      "Sid": "DiscoveryGuardTheStateKey",
      "Effect": "Deny",
      "Action": [
        "kms:ScheduleKeyDeletion",
        "kms:DisableKey",
        "kms:DisableKeyRotation",
        "kms:PutKeyPolicy",
        "kms:UpdateKeyDescription",
        "kms:DeleteImportedKeyMaterial",
        "kms:CreateAlias",
        "kms:DeleteAlias",
        "kms:UpdateAlias",
        "kms:TagResource",
        "kms:UntagResource",
        "kms:RevokeGrant"
      ],
      "Resource": "${state_kms_key_arn}"
    }
  ]
}
