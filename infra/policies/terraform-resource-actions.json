  "action_groups": [
    {
      "name": "terraform backend: the S3 state object, its lock file and the DynamoDB lock item",
      "roles": [
        "fss-rh"
      ],
      "why": "The release workflow's ambient credential is fss-rh-deploy and the S3 backend uses the ambient credential rather than the provider's assumed role. A production apply is local and its state is read by David's own admin principal, so fss-prod-deploy needs none of this.",
      "actions": [
        "s3:GetObject",
        "s3:PutObject",
        "s3:DeleteObject",
        "s3:ListBucket",
        "dynamodb:GetItem",
        "dynamodb:PutItem",
        "dynamodb:DeleteItem",
        "kms:Encrypt",
        "kms:Decrypt",
        "kms:GenerateDataKey"
      ]
    },
    {
      "name": "infra/scripts/rehearsal-caller-identity.sh and rehearsal-prefix-guard.sh",
      "roles": [
        "fss-rh",
        "fss-prod"
      ],
      "why": "The identity check and the production-inventory comparison, which are the two reads Appendix G 39 is measured with.",
      "actions": [
        "sts:GetCallerIdentity",
        "tag:GetResources"
      ]
    },
    {
      "name": "infra/scripts/release-common.sh and release-deploy.sh: the one-off tasks and the two services",
      "roles": [
        "fss-rh",
        "fss-prod"
      ],
      "why": "fss migrate, fss admin database-users ensure, fss verify and fss drill run as one-off ECS tasks inside the VPC, and the deploy scales the two services.",
      "actions": [
        "ecs:DescribeClusters",
        "ecs:DescribeTaskDefinition",
        "ecs:RunTask",
        "ecs:DescribeTasks",
        "ecs:StopTask",
        "ecs:ListTasks",
        "ecs:UpdateService",
        "ecs:DescribeServices",
        "iam:PassRole",
        "logs:GetLogEvents",
        "logs:DescribeLogStreams"
      ]
    },
    {
      "name": "infra/scripts/rehearsal-restore-drill.sh: Appendix E steps 1 to 9",
      "roles": [
        "fss-rh"
      ],
      "why": "The point-in-time restore, the wait, and the teardown of the restored instance and any snapshot the run left.",
      "actions": [
        "rds:RestoreDBInstanceToPointInTime",
        "rds:DescribeDBInstances",
        "rds:DescribeDBSnapshots",
        "rds:DeleteDBInstance",
        "rds:DeleteDBSnapshot",
        "kms:CreateGrant",
        "kms:DescribeKey"
      ]
    },
    {
      "name": "infra/scripts/rehearsal-teardown.sh: emptying the object-locked journal bucket",
      "roles": [
        "fss-rh"
      ],
      "why": "GOVERNANCE object lock with a one-day retention means a same-day destroy has to bypass it, and terraform destroy cannot remove a bucket that still holds a version or a delete marker. Never on production: docs/greenfield/release.md 1.2.",
      "actions": [
        "s3:ListBucketVersions",
        "s3:DeleteObject",
        "s3:DeleteObjectVersion",
        "s3:BypassGovernanceRetention"
      ]
    },
    {
      "name": "the release workflow's own two database entries",
      "roles": [
        "fss-rh"
      ],
      "why": "A rehearsal is unattended, so it fills migration-database from the RDS-managed master secret and app-runtime-database from a password generated in the runner. In production David fills both by hand from stdin and the role is denied both actions.",
      "actions": [
        "secretsmanager:PutSecretValue",
        "secretsmanager:GetSecretValue"
      ]
    },
    {
      "name": "the smoke check's canary datapoint",
      "roles": [
        "fss-rh",
        "fss-prod"
      ],
      "why": "scripts/productionSmoke.mjs is handed CanaryCompletionAgeSeconds, which the workflow reads with cloudwatch get-metric-statistics.",
      "actions": [
        "cloudwatch:GetMetricStatistics",
        "cloudwatch:ListMetrics"
      ]
    }
  ],
  "denied_in_production": {
    "s3:BypassGovernanceRetention": "The production suppression journal is an append-only record and Appendix E step 2 is a recovery. docs/greenfield/release.md 1.2.",
    "secretsmanager:PutSecretValue": "David fills the eight production entries by hand from stdin. A deployment role that could write a value is a deployment role that could replace a signing key.",
    "secretsmanager:GetSecretValue": "Nothing in a production apply reads a secret value. The migration credential is copied between two entries by David's own admin principal, not by the role."
  },
