{
  "name": "callie-founder-sales-system",
  "productName": "Callie Founder Sales System",
  "version": "1.0.0",
  "description": "Local-first macOS founder-sales application.",
  "main": ".vite/build/main.js",
  "private": true,
  "engines": {
    "node": ">=24.0.0 <25.0.0"
  },
  "scripts": {
    "start": "electron-forge start",
    "package": "npm run release:marker && npm run build:operational-tools && npm run build:safe-log-fs && electron-forge package",
    "make": "electron-forge make",
    "publish": "electron-forge publish",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:browser:native-desk": "playwright test --workers=1 tests/browser/nativeDesk.spec.ts tests/browser/nativeDeskComposition.spec.ts tests/browser/startupPresentation.spec.ts tests/browser/applicationPresentation.spec.ts tests/browser/applicationModals.spec.ts tests/browser/applicationLeadsReliability.spec.ts",
    "test:e2e": "playwright test --workers=1 tests/e2e/foundation.spec.ts tests/e2e/founderWorkflow.spec.ts tests/e2e/todayWorkflow.spec.ts tests/e2e/importWorkflow.spec.ts tests/e2e/fridayScoreboard.spec.ts tests/e2e/conversationsLearnings.spec.ts tests/e2e/sourcingInbox.spec.ts tests/e2e/accessibility.spec.ts tests/e2e/appleBridgeSmoke.spec.ts tests/e2e/discoveryWorkflow.spec.ts tests/e2e/bauhausWorkflow.spec.ts tests/e2e/functionalEmail.spec.ts tests/e2e/meetingFirstWorkspace.spec.ts tests/e2e/accountPreparation.spec.ts tests/e2e/reliabilityWorkflow.spec.ts tests/e2e/continuityWorkflow.spec.ts",
    "test:e2e:apple": "playwright test --workers=1 tests/e2e/appleBridgeSmoke.spec.ts",
    "typecheck": "tsc --noEmit",
    "test:helpers:node": "node --test test/appleBridgeBuild.test.mjs test/verifyAppleBridgePackage.test.mjs",
    "test:backup:electron": "CALLIE_TEST_SYNTHETIC_ELECTRON=1 vitest run test/preReleaseElectronHost.test.mjs",
    "test:swift": "swift test --package-path native/apple-bridge",
    "build:operational-tools": "node scripts/buildOperationalTools.mjs",
    "build:swift": "swift build --package-path native/apple-bridge -c release --arch arm64",
    "build:apple-bridge": "node scripts/buildAppleBridge.mjs",
    "build:safe-log-fs": "node node_modules/node-gyp/bin/node-gyp.js rebuild --directory native/safe-log-fs",
    "verify": "npm run typecheck && npm run lint:tracked && npm run test",
    "verify:e2e": "npm run package && npm run test:e2e",
    "verify:package": "npm run package && node scripts/verifyPackage.mjs",
    "rebuild:native:node": "npm rebuild better-sqlite3-multiple-ciphers && node scripts/stageEncryptedSqliteNative.mjs node",
    "rebuild:native:electron": "electron-rebuild -f -w better-sqlite3-multiple-ciphers && node scripts/stageEncryptedSqliteNative.mjs electron",
    "rebuild": "npm run rebuild:native:node && npm run rebuild:native:electron && npm run rebuild:native:node",
    "postinstall": "install-electron --no && npm run build:safe-log-fs && npm run rebuild",
    "lint:tracked": "node scripts/lintTracked.mjs",
    "knip": "knip",
    "verify:lambdas": "node scripts/verifyLambdas.mjs",
    "verify:secrets": "node scripts/verifySecrets.mjs",
    "release:marker": "node scripts/writeReleaseMarker.mjs",
    "backup:pre-release": "node scripts/createPreReleaseBackup.mjs",
    "verify:release": "node scripts/verifyRelease.mjs"
  },
  "keywords": [],
  "author": {
    "name": "David Cui",
    "email": "david_cui@brown.edu"
  },
  "license": "MIT",
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@electron-forge/cli": "^7.11.2",
    "@electron-forge/maker-deb": "^7.11.2",
    "@electron-forge/maker-rpm": "^7.11.2",
    "@electron-forge/maker-squirrel": "^7.11.2",
    "@electron-forge/maker-zip": "^7.11.2",
    "@electron-forge/plugin-auto-unpack-natives": "^7.11.2",
    "@electron-forge/plugin-vite": "^7.11.2",
    "@electron/fuses": "2.1.3",
    "@electron/rebuild": "^4.2.0",
    "@eslint/js": "^9.39.5",
    "@testing-library/react": "^16.3.3",
    "@types/better-sqlite3": "^9.6.0",
    "@types/electron-squirrel-startup": "^1.0.2",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@typescript-eslint/eslint-plugin": "8.68.0",
    "@typescript-eslint/parser": "8.68.0",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/coverage-v8": "^2.1.9",
    "electron": "44.0.0",
    "eslint": "^9.39.5",
    "eslint-plugin-import": "^2.32.0",
    "globals": "^17.12.0",
    "jsdom": "^29.1.1",
    "knip": "^6.36.0",
    "node-gyp": "^12.4.0",
    "playwright": "^1.62.1",
    "semver": "7.8.5",
    "typescript": "^5.9.3",
    "vite": "^5.4.21",
    "vitest": "^2.1.9"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1123.0",
    "@tanstack/react-table": "^8.21.3",
    "@tanstack/react-virtual": "^3.14.10",
    "better-sqlite3-multiple-ciphers": "12.11.1",
    "cheerio": "1.2.0",
    "electron-squirrel-startup": "^1.0.1",
    "kysely": "^0.29.5",
    "lucide-react": "^0.468.0",
    "papaparse": "^5.7.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zod": "^4.5.4"
  }
}
