{
  "name": "callie-founder-sales-system",
  "productName": "Callie Founder Sales System",
  "version": "1.0.0",
  "description": "Local-first macOS founder-sales application.",
  "main": ".vite/build/main.js",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=24.0.0 <25.0.0"
  },
  "scripts": {
    "start": "electron-forge start",
    "package": "npm run release:marker && npm run build:operational-tools && npm run build:safe-log-fs && electron-forge package",
    "make": "electron-forge make",
    "publish": "electron-forge publish",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:browser:native-desk": "playwright test --workers=1 tests/browser",
    "test:e2e": "playwright test --workers=1 tests/e2e/foundation.spec.ts tests/e2e/accessibility.spec.ts tests/e2e/bauhausWorkflow.spec.ts tests/e2e/meetingFirstWorkspace.spec.ts tests/e2e/accountPreparation.spec.ts tests/e2e/continuityWorkflow.spec.ts",
    "typecheck": "tsc --noEmit",
    "test:helpers:node": "node --test test/appleBridgeBuild.test.mjs test/verifyAppleBridgePackage.test.mjs",
    "test:backup:electron": "CALLIE_TEST_SYNTHETIC_ELECTRON=1 vitest run test/preReleaseElectronHost.test.mjs",
    "test:swift": "swift test --package-path native/apple-bridge",
    "build:operational-tools": "node scripts/buildOperationalTools.mjs",
    "build:swift": "swift build --package-path native/apple-bridge -c release --arch arm64",
    "build:apple-bridge": "node scripts/buildAppleBridge.mjs",
    "build:safe-log-fs": "node node_modules/node-gyp/bin/node-gyp.js rebuild --directory native/safe-log-fs",
    "verify": "npm run typecheck && npm run lint:tracked && npm run test",
    "verify:e2e": "npm run package && npm run test:e2e",
    "verify:package": "npm run package && node scripts/verifyPackage.mjs",
    "rebuild:native:node": "npm rebuild better-sqlite3-multiple-ciphers && node scripts/stageEncryptedSqliteNative.mjs node",
    "rebuild:native:electron": "electron-rebuild -f -w better-sqlite3-multiple-ciphers && node scripts/stageEncryptedSqliteNative.mjs electron",
    "rebuild": "npm run rebuild:native:node && npm run rebuild:native:electron && npm run rebuild:native:node",
    "postinstall": "install-electron --no && npm run build:safe-log-fs && npm run rebuild",
    "lint:tracked": "node scripts/lintTracked.mjs",
    "knip": "knip",
    "format:css": "prettier --check \"src/renderer/**/*.css\"",
    "verify:lambdas": "node scripts/verifyLambdas.mjs",
    "verify:secrets": "node scripts/verifySecrets.mjs",
    "release:marker": "node scripts/writeReleaseMarker.mjs",
    "backup:pre-release": "node scripts/createPreReleaseBackup.mjs",
    "diagnose:startup": "node scripts/diagnoseStartup.mjs",
    "export:cutover": "node scripts/exportCutover.mjs",
    "verify:release": "node scripts/verifyRelease.mjs",
    "typecheck:greenfield": "npm run typecheck --workspace packages/contracts && npm run typecheck --workspace packages/domain && npm run typecheck --workspace apps/api && npm run typecheck --workspace apps/worker && npm run typecheck --workspace apps/desktop",
    "lint:greenfield": "eslint --config eslint.greenfield.mjs --max-warnings 0 apps packages",
    "test:greenfield": "npm run test --workspace packages/contracts && npm run test --workspace packages/domain && npm run test --workspace apps/api && npm run test --workspace apps/worker && npm run test --workspace apps/desktop",
    "test:desktop:e2e": "npm run test:e2e --workspace apps/desktop",
    "gate:greenfield": "npm run typecheck:greenfield && npm run lint:greenfield && npm run test:greenfield"
  },
  "keywords": [],
  "author": {
    "name": "David Cui",
    "email": "david_cui@brown.edu"
  },
  "license": "MIT",
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@electron-forge/cli": "^7.11.2",
    "@electron-forge/maker-deb": "^7.11.2",
    "@electron-forge/maker-rpm": "^7.11.2",
    "@electron-forge/maker-squirrel": "^7.11.2",
    "@electron-forge/maker-zip": "^7.11.2",
    "@electron-forge/plugin-auto-unpack-natives": "^7.11.2",
    "@electron-forge/plugin-vite": "^7.11.2",
    "@electron-forge/shared-types": "7.11.2",
    "@electron/asar": "3.4.1",
    "@electron/fuses": "2.1.3",
    "@electron/rebuild": "^4.2.0",
    "@eslint/js": "^9.39.5",
    "@testing-library/react": "^16.3.3",
    "@types/electron-squirrel-startup": "^1.0.2",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@typescript-eslint/eslint-plugin": "8.68.0",
    "@typescript-eslint/parser": "8.68.0",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "44.0.0",
    "esbuild": "0.21.5",
    "eslint": "^9.39.5",
    "eslint-plugin-import": "^2.32.0",
    "globals": "^17.12.0",
    "jsdom": "^29.1.1",
    "knip": "^6.36.0",
    "node-gyp": "^12.4.0",
    "playwright": "^1.62.1",
    "prettier": "3.9.6",
    "semver": "7.8.5",
    "typescript": "^5.9.3",
    "vite": "^5.4.21",
    "vitest": "^2.1.9"
  },
  "dependencies": {
    "better-sqlite3-multiple-ciphers": "12.11.1",
    "cheerio": "1.2.0",
    "electron-squirrel-startup": "^1.0.1",
    "kysely": "^0.29.5",
    "lucide-react": "^0.468.0",
    "papaparse": "^5.7.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zod": "^4.5.4"
  }
}
