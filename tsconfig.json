{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "rewriteRelativeImportExtensions": true,
    "jsx": "react-jsx",
    "allowJs": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "noImplicitAny": true,
    "sourceMap": true,
    "baseUrl": ".",
    "paths": {
      "kysely/migration": [
        "node_modules/kysely/dist/migration/index"
      ],
      "@electron/fuses": [
        "node_modules/@electron/fuses/dist/index.d.ts"
      ],
      "cheerio/slim": [
        "node_modules/cheerio/dist/commonjs/slim"
      ]
    },
    "outDir": "dist",
    "moduleResolution": "node",
    "resolveJsonModule": true
  },
  "exclude": [
    "cloud",
    "client"
  ]
}
